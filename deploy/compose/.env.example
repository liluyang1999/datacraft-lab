# Run python3 deploy/scripts/deployment_env.py init. NEVER commit the real .env.

# Host user id Airflow containers run as (Linux: run `id -u`; macOS/Windows: 50000 is fine).
AIRFLOW_UID=50000

# Postgres metadata database credentials.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=airflow

# Fernet key for Airflow connection/variable encryption.
# Generated by deployment_env.py without extra Python dependencies.
AIRFLOW_FERNET_KEY=

# Secret used to sign API/UI tokens. Generate with: openssl rand -hex 32
AIRFLOW_API_SECRET_KEY=

# Shared task-execution JWT signing secret (same on scheduler, workers and API).
# Generate independently with: openssl rand -hex 32
AIRFLOW_JWT_SECRET=

# Initial Airflow admin user (created once by airflow-init).
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Host port bindings.
AIRFLOW_WEB_BIND=127.0.0.1
AIRFLOW_WEB_PORT=8080
DATACRAFT_API_PORT=8088

# Conservative single-host defaults; increase only after measuring peak memory and CPU.
AIRFLOW_PARALLELISM=1
AIRFLOW_PARSING_PROCESSES=1
# Spark master for jobs (local[2] for single host; spark://host:7077 for a cluster).
DATACRAFT_SPARK_MASTER=local[2]

# --- Multi-host (Docker Swarm) only; ignored by the single-host Compose stack ---
# Registry both swarm nodes can pull the datacraft images from. Required by swarm-deploy.sh.
DATACRAFT_REGISTRY=localhost:5000
# Image tag pushed to that registry.
DATACRAFT_TAG=latest
# Number of Celery worker replicas spread across the swarm.
AIRFLOW_WORKER_REPLICAS=2
AIRFLOW_WORKER_CONCURRENCY=1
# Exact `docker node ls` hostname owning the node-local data/log/database volumes.
# Keep all stateful services here until you have configured shared storage.
DATACRAFT_DATA_NODE=
