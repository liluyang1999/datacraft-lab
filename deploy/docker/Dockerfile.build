# syntax=docker/dockerfile:1
#
# Builder image: compiles the reactor and produces the shaded CLI jar at /dist/datacraft-cli.jar.
# Built once and consumed by the jvm / spark / airflow images via `COPY --from`. Uses JDK 25 (the
# project's target bytecode) for a containerized build independent of the host JDK, using the same
# Maven version as the wrapper in .mvn/wrapper/maven-wrapper.properties (bump both together).

ARG MAVEN_IMAGE=maven:3.9.16-eclipse-temurin-25
FROM ${MAVEN_IMAGE}

WORKDIR /workspace

# 1) Copy only the POMs first so dependency resolution is cached independently of source changes.
COPY pom.xml ./
COPY modules/core/datacraft-common/pom.xml modules/core/datacraft-common/
COPY modules/core/datacraft-config/pom.xml modules/core/datacraft-config/
COPY modules/io/datacraft-io/pom.xml modules/io/datacraft-io/
COPY modules/core/datacraft-engine/pom.xml modules/core/datacraft-engine/
COPY modules/processing/datacraft-jobs/pom.xml modules/processing/datacraft-jobs/
COPY modules/processing/datacraft-spark/pom.xml modules/processing/datacraft-spark/
COPY modules/interfaces/datacraft-api/pom.xml modules/interfaces/datacraft-api/
COPY modules/interfaces/datacraft-cli/pom.xml modules/interfaces/datacraft-cli/
RUN mvn -B -ntp -pl :datacraft-cli -am dependency:go-offline || true

# 2) Copy sources and build the shaded jar (Spark stays provided, so the jar is a few MB).
COPY . .
# Tests run in CI and locally from tests/; the image build skips compiling them (not in the context).
RUN mvn -B -ntp -pl :datacraft-cli -am package -Dmaven.test.skip=true \
    && mkdir -p /dist \
    && cp modules/interfaces/datacraft-cli/target/datacraft-cli.jar /dist/datacraft-cli.jar
