# syntax=docker/dockerfile:1
#
# Airflow image for the single-host (Compose) and multi-host (Swarm) deployments. Extends the
# official Airflow image with:
#   * a JRE 25 (to run the non-Spark CLI jar)                      -> copied from eclipse-temurin
#   * pyspark (provides spark-submit + the Spark runtime)          -> pinned to the JVM Spark version
#   * the datacraft-cli jar and the DAGs
#
# Spark jobs run in local mode via spark-submit inside this image. For a real Spark cluster, set
# DATACRAFT_SPARK_MASTER to the cluster URL; the driver then runs here in client mode, so the cluster
# also needs data paths the driver and every executor can reach (docs/guides/airflow.md).
# No DAG or service runs the separate datacraft/spark image.

# No default: build-images.sh passes the locally built builder. A bare name here would resolve to
# docker.io/datacraft/*, a Docker Hub namespace this project does not own.
ARG JAR_IMAGE
ARG AIRFLOW_IMAGE=apache/airflow:3.3.2
ARG JRE_IMAGE=eclipse-temurin:25-jre

FROM ${JAR_IMAGE} AS jar
FROM ${JRE_IMAGE} AS jre

FROM ${AIRFLOW_IMAGE}
ARG SPARK_VERSION=4.2.0

# --- JRE 25 (exact version, independent of the base image's Debian java packages) ---
COPY --from=jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# --- Application artifact ---
USER root
COPY --from=jar /dist/datacraft-cli.jar /opt/datacraft/datacraft-cli.jar
# Docker seeds the empty datacraft-data volume from this directory. Group 0 needs write access:
# Compose runs Airflow as ${AIRFLOW_UID}:0, and a UID other than 50000 only matches the group.
RUN mkdir -p /opt/datacraft/data && chown -R airflow:0 /opt/datacraft && chmod -R g+rwX /opt/datacraft/data
USER airflow

# --- Python deps: providers + pyspark (spark-submit lives under the pyspark package) ---
COPY orchestration/airflow/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir "apache-airflow==${AIRFLOW_VERSION}" -r /tmp/requirements.txt \
      --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-$(python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")').txt" \
    && pip install --no-cache-dir "apache-airflow==${AIRFLOW_VERSION}" "pyspark==${SPARK_VERSION}" \
    && pip check

# pyspark ships spark-submit under its package bin/. Resolve that path instead of hardcoding a
# Python minor version, so the image keeps working when the Airflow base image bumps Python.
RUN python -c 'import pathlib, pyspark; print(pathlib.Path(pyspark.__file__).parent)' > /tmp/pyspark_home
USER root
RUN ln -sfn "$(cat /tmp/pyspark_home)" /opt/pyspark && rm /tmp/pyspark_home
COPY --chmod=755 deploy/scripts/airflow-bootstrap.sh /opt/datacraft/airflow-bootstrap.sh
USER airflow
ENV SPARK_HOME=/opt/pyspark
ENV PATH="${SPARK_HOME}/bin:${PATH}"

# --- DAGs + datacraft environment ---
COPY orchestration/airflow/dags/ ${AIRFLOW_HOME}/dags/
ENV DATACRAFT_HOME=/opt/datacraft \
    DATACRAFT_CLI_JAR=/opt/datacraft/datacraft-cli.jar \
    DATACRAFT_SPARK_SUBMIT=spark-submit \
    DATACRAFT_SPARK_MASTER=local[*]
