# Keep the Docker build context small and reproducible.
.git/
.github/
**/target/
.venv/
**/__pycache__/
.idea/
*.iml
*.ipr
*.iws
.vscode/
.worktrees/
data/
logs/
tmp/
*.log
docs/engineering-report/
deploy/compose/.env

# Runtime state, database dumps and env files that .gitignore already excludes: never send them to
# the daemon, where Dockerfile.build's `COPY . .` would bake them into an image layer.
backups/
warehouse/
spark-warehouse/
.airflow/
**/.env

# Local assistant state, including nested git worktrees (full source copies).
.claude/
