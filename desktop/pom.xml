<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- The root POM is the parent for its conventions (Java floor, Enforcer, Spotless, Checkstyle,
         plugin versions). Only the opt-in desktop profile adds this module; the default backend
         build neither builds nor depends on the app. The complete gate, including external test
         formatting, is ./mvnw -Pdesktop -pl :datacraft-desktop -am verify. -->
    <parent>
        <groupId>com.example.datacraft</groupId>
        <artifactId>datacraft-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>datacraft-desktop</artifactId>
    <packaging>jar</packaging>
    <name>数艺工坊 (datacraft-desktop)</name>
    <description>Desktop control panel and monitoring console for the datacraft-lab engine API and Airflow.</description>

    <properties>
        <javafx.version>25.0.5</javafx.version>
        <sqlite.jdbc.version>3.53.4.0</sqlite.jdbc.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
        <desktop.main.class>com.example.datacraft.desktop.Launcher</desktop.main.class>
        <!-- JavaFX lives on the module path, the application on the class path. JDK 24+ warns about
             native access unless it is granted: javafx.graphics for the toolkit, ALL-UNNAMED for
             sqlite-jdbc's JNI library and the DPAPI calls of the secret vault (FFM). -->
        <desktop.javafx.dir>${project.build.directory}/javafx</desktop.javafx.dir>
        <desktop.test.groups></desktop.test.groups>
        <desktop.test.excluded>e2e,${test.excluded.tags}</desktop.test.excluded>
        <desktop.native.access>--enable-native-access=javafx.graphics,ALL-UNNAMED</desktop.native.access>
        <!-- Exercise the same bounded heap as the packaged console, including large-log UI tests. -->
        <desktop.test.jvm.args>${test.jvm.args} -Xms32m -Xmx256m --module-path ${desktop.javafx.dir} --add-modules javafx.controls ${desktop.native.access} -Ddatacraft.desktop.test=true</desktop.test.jvm.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.jdbc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The repository's layout applies: the app is under desktop/, its tests under
             tests/jvm/datacraft-desktop/ (the parent's testSourceDirectory) and its documents
             under docs/desktop/. -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- The JavaFX jars of this platform, as the module path of the tests and of the
                         packaged app. -->
                    <execution>
                        <id>javafx-module-path</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>org.openjfx</includeGroupIds>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${desktop.javafx.dir}</outputDirectory>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                    <execution>
                        <id>class-path</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <excludeGroupIds>org.openjfx</excludeGroupIds>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${desktop.test.jvm.args}</argLine>
                    <!-- The end-to-end tests need real backends: -Pe2e runs them (EndToEndTest). -->
                    <groups>${desktop.test.groups}</groups>
                    <excludedGroups>${desktop.test.excluded}</excludedGroups>
                    <!-- On the module path instead, so the toolkit starts as a named module and
                         prints no "unsupported JavaFX configuration" warning. -->
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.openjfx:javafx-base</classpathDependencyExclude>
                        <classpathDependencyExclude>org.openjfx:javafx-graphics</classpathDependencyExclude>
                        <classpathDependencyExclude>org.openjfx:javafx-controls</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${desktop.main.class}</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <!-- ./mvnw -f desktop/pom.xml javafx:run starts the app from the build output. -->
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <mainClass>${desktop.main.class}</mainClass>
                    <options>
                        <option>${desktop.native.access}</option>
                    </options>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <formats>
                        <format>
                            <includes combine.children="append">
                                <include>src/main/resources/**/*.css</include>
                                <include>src/main/resources/**/*.json</include>
                                <include>src/main/resources/**/*.properties</include>
                            </includes>
                        </format>
                    </formats>
                    <!-- External tests are formatted by the parent: use the desktop reactor
                         profile with -pl :datacraft-desktop -am for the complete verify gate. -->
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- ./mvnw -f desktop/pom.xml -Pe2e test, with the DATACRAFT_E2E_* variables that
                 EndToEndTest describes: only the tests against real backends. -->
            <id>e2e</id>
            <properties>
                <desktop.test.groups>e2e</desktop.test.groups>
                <desktop.test.excluded>${test.excluded.tags}</desktop.test.excluded>
            </properties>
        </profile>
    </profiles>
</project>
