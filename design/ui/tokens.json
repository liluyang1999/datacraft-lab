  "modena": {
    "about": "JavaFX Modena's own variables, so stock controls and popups follow the theme. Values name a token with @token or give a colour.",
    "tokens": {
      "-fx-base": ["@surface", "@surface"],
      "-fx-background": ["@bg-top", "@bg-top"],
      "-fx-control-inner-background": ["@input", "@input"],
      "-fx-control-inner-background-alt": ["@input", "@input"],
      "-fx-accent": ["@accent", "@accent"],
      "-fx-default-button": ["@accent-fill-top", "@accent"],
      "-fx-focus-color": ["@accent", "@accent"],
      "-fx-faint-focus-color": ["rgba(47, 134, 193, 0.18)", "rgba(93, 178, 230, 0.18)"],
      "-fx-selection-bar": ["@surface-selected", "@surface-selected"],
      "-fx-selection-bar-non-focused": ["@surface-selected", "@surface-selected"],
      "-fx-selection-bar-text": ["@text", "@text"],
      "-fx-text-base-color": ["@text", "@text"],
      "-fx-text-background-color": ["@text", "@text"],
      "-fx-text-inner-color": ["@text", "@text"],
      "-fx-mark-color": ["@text-secondary", "@text-secondary"],
      "-fx-box-border": ["@line", "@line"],
      "-fx-text-box-border": ["#C9D5E0", "#2A4054"],
      "-fx-prompt-text-fill": ["@prompt", "@prompt"]
    }
  },
  "type": {
    "about": "Font sizes in px. Chinese uses the system UI font; standalone figures and Latin names use Barlow; logs use the system monospace.",
    "scale": {
      "caption": 12,
      "body": 13,
      "section": 15,
      "lead": 18,
      "title": 20,
      "metric": 24,
      "display": 28
    }
  },
  "radius": {
    "about": "Corner radii in px, by layer: marks and meter cells, controls, rows and nav items, cards and task cards, tiles, pills and rings.",
    "scale": {
      "none": 0,
      "mark": 4,
      "control": 6,
      "row": 8,
      "card": 10,
      "tile": 12,
      "pill": 999
    }
  },
  "space": {
    "about": "Spacing in px on a 4 px rhythm; 2 and 6 only inside compact controls.",
    "scale": [2, 4, 6, 8, 12, 16, 20, 24, 28, 32, 48]
  },
  "motion": {
    "about": "Durations in ms. Everything moves only in answer to a change; reduced motion turns all of it into a direct switch.",
    "scale": {
      "fade": 120,
      "card": 140,
      "drawer": 160,
      "toast": 160,
      "bars": 240,
      "mark": 320,
      "ring": 420,
      "donut": 520
    }
  }
