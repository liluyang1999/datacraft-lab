<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.datacraft</groupId>
        <artifactId>datacraft-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>datacraft-jobs</artifactId>
    <name>datacraft-jobs</name>

    <dependencies>
        <dependency>
            <groupId>com.example.datacraft</groupId>
            <artifactId>datacraft-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.example.datacraft</groupId>
            <artifactId>datacraft-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.example.datacraft</groupId>
            <artifactId>datacraft-io</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-module-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.example.datacraft</exclude>
                                        <exclude>org.apache.spark</exclude>
                                    </excludes>
                                    <includes>
                                        <include>com.example.datacraft:datacraft-common</include>
                                        <include>com.example.datacraft:datacraft-engine</include>
                                        <include>com.example.datacraft:datacraft-io</include>
                                    </includes>
                                    <message>datacraft-jobs may depend only on datacraft-common, datacraft-engine and datacraft-io, and never on Spark (design/architecture.md, "Module responsibilities").</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
