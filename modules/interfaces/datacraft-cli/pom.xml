<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.datacraft</groupId>
        <artifactId>datacraft-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>datacraft-cli</artifactId>
    <name>datacraft-cli</name>

    <properties>
        <!-- No JUnit classes here: scalatest-maven-plugin runs this module's tests, so Surefire,
             which would find nothing (and cannot filter tags without a JUnit engine), is skipped. -->
        <surefire.skip>true</surefire.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.example.datacraft</groupId>
            <artifactId>datacraft-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.example.datacraft</groupId>
            <artifactId>datacraft-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.example.datacraft</groupId>
            <artifactId>datacraft-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.example.datacraft</groupId>
            <artifactId>datacraft-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.example.datacraft</groupId>
            <artifactId>datacraft-io</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.example.datacraft</groupId>
            <artifactId>datacraft-jobs</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.example.datacraft</groupId>
            <artifactId>datacraft-spark</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.scopt</groupId>
            <artifactId>scopt_${scala.binary.version}</artifactId>
        </dependency>
        <dependency>
            <groupId>org.scalatest</groupId>
            <artifactId>scalatest_${scala.binary.version}</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>datacraft-cli</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- Dependency manifests are filtered out below; this adds the fat jar's
                                     entries to the module's own manifest. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.example.datacraft.cli.Runner</mainClass>
                                    <manifestEntries>
                                        <!-- Keeps the META-INF/versions classes of multi-release
                                             dependencies (jsch Ed25519/X25519/ML-KEM, Jackson) active. -->
                                        <Multi-Release>true</Multi-Release>
                                        <Implementation-Title>${project.artifactId}</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Build-Jdk-Spec>${java.version}</Build-Jdk-Spec>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                <!-- Jackson's NOTICE files differ (jackson-core adds third-party notices);
                                     merge them instead of keeping only the first. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <addHeader>false</addHeader>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>reference.conf</resource>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- A dependency's module descriptor must not describe the fat jar. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                                <!-- The three Jackson jars carry byte-identical Apache License 2.0 texts:
                                     keep jackson-annotations' copy as the fat jar's META-INF/LICENSE. -->
                                <filter>
                                    <artifact>com.fasterxml.jackson.core:jackson-core</artifact>
                                    <excludes>
                                        <exclude>META-INF/LICENSE</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.fasterxml.jackson.core:jackson-databind</artifact>
                                    <excludes>
                                        <exclude>META-INF/LICENSE</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
